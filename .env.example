APP_ENV=development

# Storage Settings
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# Whisper Settings (CPU int8)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Vision Settings (Qwen3-VL-2B GGUF via llama.cpp or Mock/Rule)
VISION_PROVIDER=rule
VISION_MODEL_PATH=
VISION_MMPROJ_PATH=

# Translation Settings (M2M100 418M via CTranslate2 or Mock)
TRANSLATION_PROVIDER=mock
TRANSLATION_MODEL_PATH=

# Validation Limits
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=30
